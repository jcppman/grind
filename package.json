{
  "name": "grind",
  "version": "0.2.0",
  "private": true,
  "description": "Vendor-neutral CLI and plugin for resumable development initiatives",
  "type": "module",
  "bin": {
    "grind": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    ".codex-plugin",
    ".claude-plugin",
    "scripts/grind.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "test:package": "npm run package:plugin && node --test scripts/package.test.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
